# Human Radar on the Waveshare ESP32-P4-WIFI6-Touch-LCD-4B (ESP32-P4-Core module: ESP32-P4NRW32)
# Applied automatically when sdkconfig is generated; change settings with `idf.py menuconfig`.
CONFIG_IDF_TARGET="esp32p4"

# 32 MB NOR flash on the module (flash mode stays at the safe DIO default)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# 32 MB PSRAM stacked in the chip package, 16-bit (hex) bus
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# The serial console is UART0 (GPIO37/GPIO38 -> CH343P on the USB TO UART port), which is the default

# The board ships with ESP32-P4 silicon rev v1.x (v1.3 measured). ESP-IDF v6 builds for rev v3.x by
# default and esptool then refuses to flash ("requires chip revision in range v3.1 - v3.99").
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Partition table: one 8 MB app slot, see partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BSP init (LVGL, codec) runs from app_main
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Board support package: RGB565 with three DSI frame buffers for tear-free LVGL
# (the LCD type choice is informational, the BSP always uses the 720x720 ST7703 timing)
CONFIG_BSP_LCD_TYPE_720_720_4_INCH=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3

# LVGL, as recommended by esp_lvgl_adapter: 1 kHz tick, FreeRTOS integration, two software draw units
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2

# Fonts: UNSCII for the terminal look of the scope, Montserrat 32 for the alert banner
CONFIG_LV_FONT_UNSCII_8=y
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_FONT_MONTSERRAT_32=y

# Larger L2 cache helps with the frame buffers in PSRAM
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# BSP calls return errors instead of aborting (a missing clip partition must not reboot the prop)
CONFIG_BSP_ERROR_CHECK=n
